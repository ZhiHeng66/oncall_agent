# Copy to .env and replace placeholders. Never commit real credentials.
DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# Role-specific models used by the multi-agent workflow.
RAG_MODEL=qwen-plus
SUPERVISOR_MODEL=qwen-plus
SPECIALIST_MODEL=qwen-plus
REVIEWER_MODEL=qwen-plus
LLM_ENABLE_THINKING=false

MILVUS_HOST=localhost
MILVUS_PORT=19530

# PostgreSQL is the default persistence backend.
CHECKPOINTER_BACKEND=postgres
DATABASE_URL=postgresql://oncall_agent:replace-with-postgres-password@localhost:5432/oncall_agent
POSTGRES_DB=oncall_agent
POSTGRES_USER=oncall_agent
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_PORT=5432
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Local single-tenant authentication. Generate a long random value before enabling it.
AUTH_ENABLED=false
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional local fallback only: CHECKPOINTER_BACKEND=sqlite
# CHECKPOINT_PATH=data/multi_agent.sqlite3

MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_TICKET_URL=http://localhost:8005/mcp
